.env

# Runtime state
nginx/log/

# Cache
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Editors
.vscode/
.idea/

# Claude Code
.claude/*.local.*
CLAUDE.local.md

# Brainstorming / mockup cache produced by the superpowers skill
/.superpowers/

# Per-worktree Claude Code scratch directory (CLAUDE.md)
.tmp/

# Sphinx build output
docs/_build/
scripts/docs-gate-fixture/_build/

# scripts/ci-lint-selftest.sh's fixtures live at real, meaningful paths (not
# under .tmp/) so prek matches them the same way it would a genuine file;
# ignored so a leak from an aborted run (or a concurrent invocation racing
# past this script's own flock) can't be staged by `git add -A` or trip
# scripts/deploy.sh's dirty-worktree check.
/.prek-gate-fixture-*.sh
portal/src/postern/_ty_gate_fixture_*.py
